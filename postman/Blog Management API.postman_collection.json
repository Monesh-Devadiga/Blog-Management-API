{
  "info": {
    "name": "Blog Management API",
    "description": "API collection for the Blog Management system with authentication, categories, blogs, search, and pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"]}
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "  pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"]}
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"]}
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Technology\",\n  \"description\": \"Posts about technology and software\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"]}
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"]}
          }
        },
        {
          "name": "Search Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/categories?search=tech", "host": ["{{baseUrl}}"], "path": ["categories"], "query": [{"key": "search", "value": "tech"}]}
          }
        },
        {
          "name": "Get Category By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/categories/:id", "host": ["{{baseUrl}}"], "path": ["categories", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Technology & Programming\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/categories/:id", "host": ["{{baseUrl}}"], "path": ["categories", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/categories/:id", "host": ["{{baseUrl}}"], "path": ["categories", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "Create Blog",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Getting Started with Node.js\",\n  \"content\": \"Node.js is a JavaScript runtime built on Chrome's V8 engine. It allows you to run JavaScript on the server side, enabling full-stack development with a single language.\\n\\n## Why Node.js?\\n- Event-driven, non-blocking I/O\\n- NPM ecosystem\\n- Fast execution\\n- Great for real-time applications\\n\\n## Getting Started\\n1. Install Node.js from the official website\\n2. Create a new project directory\\n3. Run `npm init`\\n4. Start building your application\",\n  \"category\": \"YOUR_CATEGORY_ID\",\n  \"tags\": [\"nodejs\", \"javascript\", \"backend\"],\n  \"status\": \"published\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/blogs", "host": ["{{baseUrl}}"], "path": ["blogs"]}
          }
        },
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs", "host": ["{{baseUrl}}"], "path": ["blogs"]}
          }
        },
        {
          "name": "Search Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?search=nodejs&page=1&limit=5", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "search", "value": "nodejs"}, {"key": "page", "value": "1"}, {"key": "limit", "value": "5"}]}
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?category=CATEGORY_ID", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "category", "value": "CATEGORY_ID"}]}
          }
        },
        {
          "name": "Filter by Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?status=draft", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "status", "value": "draft"}]}
          }
        },
        {
          "name": "Filter by Tag",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?tag=nodejs", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "tag", "value": "nodejs"}]}
          }
        },
        {
          "name": "Filter by Date Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?startDate=2024-01-01&endDate=2026-12-31", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "startDate", "value": "2024-01-01"}, {"key": "endDate", "value": "2026-12-31"}]}
          }
        },
        {
          "name": "Pagination Example",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["blogs"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}]}
          }
        },
        {
          "name": "Get My Blogs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/blogs/my-blogs", "host": ["{{baseUrl}}"], "path": ["blogs", "my-blogs"]}
          }
        },
        {
          "name": "Get Blog By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/blogs/:id", "host": ["{{baseUrl}}"], "path": ["blogs", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        },
        {
          "name": "Update Blog",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated: Getting Started with Node.js\",\n  \"status\": \"published\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/blogs/:id", "host": ["{{baseUrl}}"], "path": ["blogs", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/blogs/:id", "host": ["{{baseUrl}}"], "path": ["blogs", ":id"], "variable": [{"key": "id", "value": ""}]}
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"]}
          }
        }
      ]
    }
  ]
}
